# ============================================================
# AgentBuddy Server 环境变量配置
# ============================================================
# 部署：复制本文件为 .env（同目录），填入真实值
#   cp server/.env.example server/.env && vi server/.env
#
# 加载方式（任选其一）：
#
# 1. 自动加载（推荐，已内置）：
#    PluginMarketWorker.py / app.py 启动时会自动读取 server/.env，
#    shell/system 已注入的环境变量优先（不被 .env 覆盖）。
#    直接运行：python PluginMarketWorker.py --crawler-agent
#
# 2. 手动 source（cron / 跨账户场景，需显式注入）：
#    set -a && . ./server/.env && set +a
#    python server/PluginMarketWorker.py --crawler-agent
#
# 3. systemd 服务：在 [Service] 段加 EnvironmentFile=/path/to/server/.env
#
# 4. cron（无自动加载时）：0 4 * * * cd /path/to/server && set -a && . ./.env && set +a && python PluginMarketWorker.py --crawler-agent >> /var/log/agentbuddy-crawler-agent.log 2>&1
# ============================================================


# ── CrawlerAgent（搜索智能体）必填 ──
# OpenAI 兼容 LLM 的 API Key（用于 topic 扩展 / skill 抽取）
OPENAI_API_KEY=

# Tavily 搜索 API Key（Google 搜索发现，独立 MCP 凭据）
# 申请：https://tavily.com
TAVILY_API_KEY=

# ── CrawlerAgent 可选（LLM 配置） ──
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Flask 服务安全（生产必改） ──
# JWT 签名密钥：保护浏览器登录态。默认值是源码占位串，生产必须替换为
# 32 字节以上随机字符串（可用 python -c "import secrets;print(secrets.token_urlsafe(32))" 生成）
AGENTBUDDY_JWT_SECRET=agentbuddy-server-secret-2026

# ── Flask 服务监听（可选） ──
AGENTBUDDY_SERVER_HOST=0.0.0.0
AGENTBUDDY_SERVER_PORT=5001

# ── PluginMarketWorker 调度（可选） ──
# 远程发布模式才用（直连模式忽略）
AGENTBUDDY_SERVER_URL=http://127.0.0.1:5001

# 内置每日调度（app.py 启动线程，默认凌晨 3 点）
AGENTBUDDY_CRAWL_ENABLED=1
AGENTBUDDY_CRAWL_HOUR=3
AGENTBUDDY_CRAWL_QUOTA=10

# ── 数据目录（可选，默认 ./data，相对 server 目录） ──
# AGENTBUDDY_DATA_DIR=./data

# ── LLM 配置文件路径（可选，默认 ./config/llm/llm.yaml，相对 server 目录） ──
# AGENTBUDDY_LLM_CONFIG=./config/llm/llm.yaml
