#!/usr/bin/env sh
set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if [ -x ".venv/bin/python" ]; then
  PYTHON=".venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON="python3"
else
  PYTHON="python"
fi

echo "[pre-commit] Running AgentBuddy tests..."
"$PYTHON" -m pytest -q
