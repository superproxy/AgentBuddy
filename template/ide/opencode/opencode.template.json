{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true
  },
  "provider": {
    "${LLM_ACTIVE_PROVIDER}": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "${LLM_ACTIVE_PROVIDER}",
      "options": {
        "baseURL": "${LLM_ACTIVE_BASE_URL}",
        "apiKey": "${LLM_ACTIVE_API_KEY}"
      }
    }
  },
  "model": "${LLM_ACTIVE_PROVIDER}/${LLM_ACTIVE_MODEL}",
  "small_model": "openai/gpt-4o-mini",
  "mcp": {},

  "lsp": true,

  "agent": {
    "review": {
      "description": "Reviews code for best practices and potential issues"
    }
  },
  "permission":{
    "*": "allow",
    "bash": "allow",
    "edit": "allow"
  }

}
